spring.application.name=ayojon
server.port=8081

spring.datasource.url=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
spring.datasource.username=postgres.jgebvzdtzhozddbrnvlb
spring.datasource.password=YOUR_SUPABASE_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# The schema is owned by Flyway (src/main/resources/db/migration).
# Hibernate only checks that the entities match it — never let it change tables.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

# Migrations run automatically on startup. db/seed loads demo data once;
# remove it from the list for a production database.
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration,classpath:db/seed
